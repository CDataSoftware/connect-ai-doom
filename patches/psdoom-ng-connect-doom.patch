+// connect-doom: PSDOOM_MONSTERS lists six doomednums, a record's then an urgent record's
+// monster for rooms 1-3 (tools/themes.py). A missing or unknown number keeps psdoom's own
+// pair: shotgun guys, and pink demons for urgent records.
+static mobjtype_t room_monster(int room, int urgent)
+{
+    static mobjtype_t table[3][2];
+    static boolean loaded = false;
+
+    if (!loaded) {
+        const char *env = getenv("PSDOOM_MONSTERS");
+        int r, u, i;
+
+        for (r = 0; r < 3; r++) {
+            table[r][0] = MT_SHOTGUY;
+            table[r][1] = MT_SERGEANT;
+        }
+        for (r = 0; env && r < 3; r++) {
+            for (u = 0; u < 2; u++) {
+                char *end;
+                long num = strtol(env, &end, 10);
+
+                if (end == env)
+                    break;
+                env = end;
+                for (i = 0; i < NUMMOBJTYPES; i++) {
+                    if (mobjinfo[i].doomednum == num && (mobjinfo[i].flags & MF_COUNTKILL)) {
+                        table[r][u] = i;
+                        break;
+                    }
+                }
+            }
+        }
+        loaded = true;
+    }
+    return table[room][urgent];
+}
