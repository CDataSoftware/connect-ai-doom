+// *** AGENT BEGIN ***
+// connect-doom "Claude plays": an external agent steers the player.
+// Enabled when PSDOOM_AGENT_DIR is set. The agent writes one command line to
+// <dir>/cmd ("<seq> MOVE x y" | "<seq> USE" | "<seq> ATTACK pid" | "<seq> TURN deg"
+// | "<seq> KEY code" | "<seq> RESTART" | "<seq> OPTION n 0|1" | "<seq> STOP"); KEY presses a key,
+// e.g. to screenshot the menus; RESTART starts the level over; OPTION sets a switch. The game
+// writes <dir>/state.json every few tics with the player, the process monsters, the last
+// finished command, the Options menu's two switches (Claude plays, which PSDOOM_AGENT_CLAUDE
+// sets at launch, and auto replay, PSDOOM_AGENT_LOOP) and how long since a person last
+// touched a key or the mouse. While Claude plays is off, the commands that steer are refused.
+
+#include "d_event.h"
+#include "d_player.h"
+#include "d_ticcmd.h"
+#include "tables.h"
+#include "r_main.h"
+#include "doomstat.h"
+#include "g_game.h"
+
+void D_PostEvent(event_t *ev);
+
+// From p_local.h, which can't be included here (its enum 'close' clashes with unistd.h).
+extern thinker_t thinkercap;
+fixed_t P_AproxDistance(fixed_t dx, fixed_t dy);
+boolean P_CheckSight(mobj_t *t1, mobj_t *t2);
+void P_MobjThinker(mobj_t *mobj);
+#define AGENT_ANG1 (ANG45 / 45)
+
+static char *agent_dir = NULL;
+static int agent_seq = 0, agent_done_seq = 0, agent_tics = 0, agent_clock = 0;
+static char agent_verb[16] = "", agent_result[64] = "idle";
+static int agent_x, agent_y, agent_pid, agent_deg;
+static int agent_last_dist, agent_stuck;
+// The Options menu's switches, -1 until read from the env: Claude plays, auto replay, god mode
+// (for people; Claude always has it), saved data (the bridge stops asking Connect AI) and offline
+// Claude (play.py's scripted player instead of Claude: no AI tokens).
+#define AGENT_NOPTIONS 7
+static int agent_options[AGENT_NOPTIONS] = {-1, -1, -1, -1, -1, -1, -1};
+static const char *agent_option_env[AGENT_NOPTIONS] = {
+    "PSDOOM_AGENT_CLAUDE", "PSDOOM_AGENT_LOOP", "PSDOOM_OPT_GOD", "PSDOOM_OPT_SAVED", "PSDOOM_OPT_OFFLINE",
+    "PSDOOM_OPT_MUSIC", "PSDOOM_OPT_SFX"};
+static const int agent_option_default[AGENT_NOPTIONS] = {0, 0, 0, 0, 0, 1, 1};   // music and sound: on
+static const char *agent_option_msg[AGENT_NOPTIONS][2] = {
+    {"CLAUDE PLAYS OFF: YOUR TURN", "CLAUDE PLAYS: CLAUDE TAKES OVER"},
+    {"AUTO REPLAY OFF", "AUTO REPLAY ON: THE LEVEL RESTARTS ONCE CLEARED"},
+    {"GOD MODE OFF", "GOD MODE ON: PLAYERS CAN'T DIE"},
+    {"SAVED DATA OFF: LIVE FROM CONNECT AI", "SAVED DATA ON: NO CONNECT AI CALLS, THE LAST SAVED RECORDS"},
+    {"OFFLINE CLAUDE OFF: CLAUDE PLAYS LIVE", "OFFLINE CLAUDE ON: A SCRIPTED PLAYER, NO AI TOKENS"},
+    {"MUSIC OFF", "MUSIC ON"},
+    {"SOUND EFFECTS OFF", "SOUND EFFECTS ON"}};
+void S_SoundSwitched(void);   // s_sound.c: the music and sound switches' volumes
+static int agent_last_input = 0;          // gametic of a person's last key or mouse event
+#define AGENT_KEY_MARK 0x4147             // data3 of the keys KEY presses: not a person
+
+// From D_ProcessEvents: every event, so idle time counts a person's input only.
+void PR_AgentNoteInput(event_t *ev)
+{
+    if (ev->type == ev_keyup || (ev->type == ev_keydown && ev->data3 == AGENT_KEY_MARK))
+        return;
+    if (ev->type == ev_mouse && !ev->data1 && !ev->data2 && !ev->data3)
+        return;
+    agent_last_input = gametic;
+}
+
+static void agent_finish(const char *result);
+
+int PR_AgentOption(int option)
+{
+    if (option < 0 || option >= AGENT_NOPTIONS)
+        return 0;
+    if (agent_options[option] < 0)
+    {
+        const char *v = getenv(agent_option_env[option]);
+        agent_options[option] = v != NULL && v[0] ? strcmp(v, "0") != 0 : agent_option_default[option];
+    }
+    return agent_options[option];
+}
+
+// From the Options menu. play.py's supervisor watches state.json and starts or stops Claude,
+// and the bridge follows the saved data switch.
+void PR_AgentToggle(int option)
+{
+    player_t *p = &players[consoleplayer];
+    if (option < 0 || option >= AGENT_NOPTIONS)
+        return;
+    agent_options[option] = !PR_AgentOption(option);
+    p->message = agent_option_msg[option][agent_options[option]];
+    if (option == 5 || option == 6)
+        S_SoundSwitched();
+    if ((option == 0 || option == 2) && !PR_AgentOption(0) && !PR_AgentOption(2))
+        p->cheats &= ~CF_GODMODE;      // nobody's god mode any more
+    if (option == 0 && !agent_options[0] && agent_verb[0])
+        agent_finish("stopped");
+}
+
+static void agent_finish(const char *result)
+{
+    agent_done_seq = agent_seq;
+    agent_verb[0] = '\0';
+    snprintf(agent_result, sizeof(agent_result), "%s", result);
+}
+
+static mobj_t *agent_find(int pid)
+{
+    thinker_t *th;
+    for (th = thinkercap.next; th != &thinkercap; th = th->next)
+    {
+        if (th->function.acp1 == (actionf_p1) P_MobjThinker
+         && ((mobj_t *) th)->m_pid == pid)
+            return (mobj_t *) th;
+    }
+    return NULL;
+}
+
+static void agent_read_cmd(void)
+{
+    char path[512], line[128], verb[16];
+    int seq, a = 0, b = 0;
+    FILE *f;
+    snprintf(path, sizeof(path), "%s/cmd", agent_dir);
+    f = fopen(path, "r");
+    if (!f)
+        return;
+    if (fgets(line, sizeof(line), f)
+     && sscanf(line, "%d %15s %d %d", &seq, verb, &a, &b) >= 2 && seq > agent_seq)
+    {
+        agent_seq = seq;
+        snprintf(agent_verb, sizeof(agent_verb), "%s", verb);
+        agent_x = a; agent_y = b; agent_pid = a; agent_deg = a;
+        agent_tics = 0;
+        agent_last_dist = 1 << 30;
+        agent_stuck = 0;
+        snprintf(agent_result, sizeof(agent_result), "running");
+    }
+    fclose(f);
+}
+
+// Turn toward an angle; returns the remaining error in degrees.
+static int agent_turn_to(ticcmd_t *cmd, mobj_t *mo, angle_t target)
+{
+    int delta = (int) (target - mo->angle);     // signed: shortest way round
+    int turn = delta >> 16;
+    if (turn > 1536) turn = 1536;
+    if (turn < -1536) turn = -1536;
+    cmd->angleturn = turn;
+    return abs(delta / (int) (AGENT_ANG1));
+}
+
+static void agent_write_state(player_t *p)
+{
+    char path[512], tmp[520];
+    FILE *f;
+    thinker_t *th;
+    int first = 1;
+    mobj_t *mo = p->mo;
+    snprintf(path, sizeof(path), "%s/state.json", agent_dir);
+    snprintf(tmp, sizeof(tmp), "%s.tmp", path);
+    f = fopen(tmp, "w");
+    if (!f)
+        return;
+    fprintf(f, "{\"tic\": %d, \"player\": {\"x\": %d, \"y\": %d, \"angle\": %d, \"health\": %d, "
+               "\"armor\": %d, \"ammo\": %d, \"keys\": {\"blue\": %d, \"yellow\": %d, \"red\": %d}, "
+               "\"kills\": %d},\n \"options\": {\"claude_plays\": %d, \"auto_replay\": %d, \"god_mode\": %d, "
+               "\"saved_data\": %d, \"offline_claude\": %d, \"music\": %d, \"sound_effects\": %d}, "
+               "\"idle_seconds\": %d,\n",
+            agent_clock, mo->x >> FRACBITS, mo->y >> FRACBITS,
+            (int) (mo->angle / AGENT_ANG1), p->health, p->armorpoints,
+            weaponinfo[p->readyweapon].ammo < NUMAMMO ? p->ammo[weaponinfo[p->readyweapon].ammo] : -1,
+            p->cards[it_bluecard], p->cards[it_yellowcard], p->cards[it_redcard], p->killcount,
+            PR_AgentOption(0), PR_AgentOption(1), PR_AgentOption(2), PR_AgentOption(3),
+            PR_AgentOption(4), PR_AgentOption(5), PR_AgentOption(6), (gametic - agent_last_input) / TICRATE);
+    fprintf(f, " \"command\": {\"seq\": %d, \"done_seq\": %d, \"verb\": \"%s\", \"result\": \"%s\"},\n",
+            agent_seq, agent_done_seq, agent_verb, agent_result);
+    fprintf(f, " \"monsters\": [");
+    for (th = thinkercap.next; th != &thinkercap; th = th->next)
+    {
+        mobj_t *m;
+        if (th->function.acp1 != (actionf_p1) P_MobjThinker)
+            continue;
+        m = (mobj_t *) th;
+        if (!m->m_pid)
+            continue;
+        fprintf(f, "%s\n  {\"pid\": %d, \"name\": \"%.7s\", \"x\": %d, \"y\": %d, \"health\": %d, "
+                   "\"visible\": %s, \"distance\": %d}",
+                first ? "" : ",", m->m_pid, m->m_pname, m->x >> FRACBITS, m->y >> FRACBITS, m->health,
+                m->health > 0 && P_CheckSight(mo, m) ? "true" : "false",
+                P_AproxDistance(m->x - mo->x, m->y - mo->y) >> FRACBITS);
+        first = 0;
+    }
+    fprintf(f, "]}\n");
+    fclose(f);
+    rename(tmp, path);
+}
+
+void PR_AgentTiccmd(ticcmd_t *cmd)
+{
+    player_t *p = &players[consoleplayer];
+    mobj_t *mo = p->mo;
+
+    if (agent_dir == NULL)
+    {
+        static int checked = 0;
+        if (checked)
+            return;
+        checked = 1;
+        agent_dir = getenv("PSDOOM_AGENT_DIR");
+        if (agent_dir == NULL)
+            return;
+    }
+    if (gamestate != GS_LEVEL || mo == NULL)
+        return;
+
+    if (PR_AgentOption(0))
+    {
+        // Claude thinks slowly: don't let it die mid-thought, and keep it on a
+        // full chaingun (hitscan, so aiming is reliable; rockets splash and run dry).
+        int i;
+        p->cheats |= CF_GODMODE;
+        p->weaponowned[wp_chaingun] = true;
+        for (i = 0; i < NUMAMMO; i++)
+            p->ammo[i] = p->maxammo[i];
+        if (p->readyweapon != wp_chaingun && p->pendingweapon == wp_nochange)
+            p->pendingweapon = wp_chaingun;
+    }
+    else if (PR_AgentOption(2))
+        p->cheats |= CF_GODMODE;       // the Options menu's god mode: people can't die
+
+    ++agent_clock;
+    if (agent_clock % 4 == 0)
+    {
+        agent_read_cmd();
+        agent_write_state(p);
+    }
+    if (!agent_verb[0])
+        return;
+    ++agent_tics;
+
+    if (!strcmp(agent_verb, "STOP"))
+    {
+        agent_finish("stopped");
+    }
+    else if (!strcmp(agent_verb, "OPTION"))
+    {
+        // play.py's idle takeover: the same as choosing it in the Options menu
+        if (agent_x >= 0 && agent_x < AGENT_NOPTIONS && PR_AgentOption(agent_x) != !!agent_y)
+            PR_AgentToggle(agent_x);
+        agent_finish("set");
+    }
+    else if (!PR_AgentOption(0) && strcmp(agent_verb, "KEY") && strcmp(agent_verb, "SHOT"))
+    {
+        agent_finish("claude plays is off");
+    }
+    else if (!strcmp(agent_verb, "RESTART"))
+    {
+        // Back to the start: keycards gone, doors shut, every record spawned from the list again.
+        agent_finish("restarted");
+        G_DeferedInitNew(gameskill, gameepisode, gamemap);
+    }
+    else if (!strcmp(agent_verb, "KEY"))
+    {
+        event_t ev;
+        ev.type = ev_keydown;
+        ev.data1 = agent_x;
+        ev.data2 = 0;
+        ev.data3 = AGENT_KEY_MARK;
+        D_PostEvent(&ev);
+        ev.type = ev_keyup;
+        D_PostEvent(&ev);
+        agent_finish("pressed");
+    }
+    else if (!strcmp(agent_verb, "SHOT"))
+    {
+        // Save the frame as DOOMnn.pcx in the working directory (no window needed).
+        gameaction = ga_screenshot;
+        agent_finish("shot");
+    }
+    else if (!strcmp(agent_verb, "USE"))
+    {
+        cmd->buttons |= BT_USE;
+        if (agent_tics >= 2)
+            agent_finish("used");
+    }
+    else if (!strcmp(agent_verb, "TURN"))
+    {
+        if (agent_turn_to(cmd, mo, (angle_t) agent_deg * AGENT_ANG1) < 3 || agent_tics > 70)
+            agent_finish("turned");
+    }
+    else if (!strcmp(agent_verb, "MOVE"))
+    {
+        fixed_t tx = agent_x << FRACBITS, ty = agent_y << FRACBITS;
+        int dist = P_AproxDistance(tx - mo->x, ty - mo->y) >> FRACBITS;
+        int err = agent_turn_to(cmd, mo, R_PointToAngle2(mo->x, mo->y, tx, ty));
+        if (dist < 16)
+        {
+            agent_finish("arrived");
+            return;
+        }
+        if (err < 45)
+            cmd->forwardmove = dist < 96 ? 0x19 : 0x32;
+        // Stuck against a wall or a closed door: give up after ~2 seconds without progress.
+        if (agent_tics % 35 == 0)
+        {
+            agent_stuck = dist >= agent_last_dist - 8 ? agent_stuck + 1 : 0;
+            agent_last_dist = dist;
+            if (agent_stuck >= 2)
+                agent_finish("blocked");
+        }
+        if (agent_tics > 35 * 20)
+            agent_finish("timeout");
+    }
+    else if (!strcmp(agent_verb, "ATTACK"))
+    {
+        mobj_t *t = agent_find(agent_pid);
+        int err;
+        if (t == NULL || t->health <= 0)
+        {
+            agent_finish(t == NULL ? "gone" : "killed");
+            return;
+        }
+        err = agent_turn_to(cmd, mo, R_PointToAngle2(mo->x, mo->y, t->x, t->y));
+        if (err < 6 && P_CheckSight(mo, t))
+            cmd->buttons |= BT_ATTACK;
+        // Close in on targets that are far away or behind something.
+        if (err < 45 && (!P_CheckSight(mo, t)
+                         || P_AproxDistance(t->x - mo->x, t->y - mo->y) > (400 << FRACBITS)))
+            cmd->forwardmove = 0x32;
+        if (agent_tics > 35 * 12)
+            agent_finish(P_CheckSight(mo, t) ? "timeout" : "out of sight");
+    }
+    else
+    {
+        agent_finish("unknown command");
+    }
+}
+// *** AGENT END ***
+
+// *** AIM BEGIN ***
+// connect-doom: the record under the crosshair, shown full width above the
+// status bar ("ZENDESK: ESCALATION: STILL NO WORKING PIPELINE"). The bridge
+// writes PSDOOM_LABELS, one "pid<TAB>line1<TAB>line2" per monster.
+
+#include "doomstat.h"
+#include "r_state.h"
+#include "v_video.h"
+#include "w_wad.h"
+#include "z_zone.h"
+#include "i_swap.h"
+
+extern mobj_t *linetarget;
+fixed_t P_AimLineAttack(mobj_t *t1, angle_t angle, fixed_t distance);
+void M_WriteText(int x, int y, char *string);
+int M_StringWidth(char *string);
+extern lighttable_t *colormaps;
+
+static int aim_pid = 0, aim_checked = 0;
+static char aim_lines[2][64];
+
+static void aim_load(int pid)
+{
+    const char *path = getenv("PSDOOM_LABELS");
+    char line[256];
+    FILE *f;
+    aim_pid = pid;
+    aim_checked = gametic;
+    aim_lines[0][0] = aim_lines[1][0] = '\0';
+    if (path == NULL || (f = fopen(path, "r")) == NULL)
+        return;
+    while (fgets(line, sizeof(line), f))
+    {
+        char *a, *b;
+        if (atoi(line) != pid || (a = strchr(line, '\t')) == NULL)
+            continue;
+        a++;
+        line[strcspn(line, "\n")] = '\0';
+        b = strchr(a, '\t');
+        if (b)
+            *b++ = '\0';
+        snprintf(aim_lines[0], sizeof(aim_lines[0]), "%s", a);
+        snprintf(aim_lines[1], sizeof(aim_lines[1]), "%s", b ? b : "");
+        break;
+    }
+    fclose(f);
+}
+
+// Cut a line until it fits the screen, marking the cut with "..".
+static void aim_fit(char *s)
+{
+    size_t n = strlen(s);
+    while (n > 3 && M_StringWidth(s) > SCREENWIDTH - 12)
+    {
+        s[--n] = '\0';
+        s[n - 2] = s[n - 1] = '.';
+    }
+}
+
+// The Connect AI logo in the view's top-right corner (CAICORNR, from brand.wad).
+static void corner_logo(void)
+{
+    static int lump = -2;
+    patch_t *logo;
+    if (lump == -2)
+        lump = W_CheckNumForName("CAICORNR");
+    if (lump < 0)
+        return;
+    logo = W_CacheLumpNum(lump, PU_CACHE);
+    V_DrawPatchDirect(viewwindowx + scaledviewwidth - SHORT(logo->width) - 3, viewwindowy + 3, 0, logo);
+}
+
+void PR_DrawAimInfo(void)
+{
+    mobj_t *mo = players[consoleplayer].mo;
+    int i, y, x, rows;
+    // Not over the menu's or the pause screen's own Connect AI logo.
+    if (gamestate != GS_LEVEL || automapactive || menuactive || paused || mo == NULL)
+        return;
+    corner_logo();
+    P_AimLineAttack(mo, mo->angle, 2048 * FRACUNIT);
+    if (linetarget == NULL || !linetarget->m_pid || linetarget->health <= 0)
+        return;
+    if (linetarget->m_pid != aim_pid || (!aim_lines[0][0] && gametic - aim_checked > 35))
+        aim_load(linetarget->m_pid);
+    if (!aim_lines[0][0])
+        return;
+    rows = aim_lines[1][0] ? 2 : 1;
+    y = viewwindowy + viewheight - 4 - 9 * rows;
+    // Darken a band behind the text so it reads over any wall.
+    for (i = (y - 3) * SCREENWIDTH; i < (y + 9 * rows + 1) * SCREENWIDTH; i++)
+        screens[0][i] = colormaps[24 * 256 + screens[0][i]];
+    for (i = 0; i < rows; i++)
+    {
+        char buf[64];
+        snprintf(buf, sizeof(buf), "%s", aim_lines[i]);
+        aim_fit(buf);
+        x = (SCREENWIDTH - M_StringWidth(buf)) / 2;
+        M_WriteText(x < 0 ? 0 : x, y + 9 * i, buf);
+    }
+}
+// *** AIM END ***
+
+// *** VAULT BEGIN ***
+// connect-doom: the red door. Each time a player without the red key uses it, run
+// PSDOOMVAULTCMD in the background: the bridge sends the request Connect AI blocked
+// during the briefing again, live, for the side panel. At most once every 2 seconds.
+void PR_VaultTouched(void)
+{
+    static int last = -1000;
+    const char *cmd = getenv("PSDOOMVAULTCMD");
+    char buf[1024];
+    if (cmd == NULL || gametic - last < 70)
+        return;
+    last = gametic;
+    snprintf(buf, sizeof(buf), "%s >/dev/null 2>&1 &", cmd);
+    system(buf);
+}
+// *** VAULT END ***
