        }
-       M_WriteText(vis->x1, lowest_dc_yl, buf);
-       M_WriteText(vis->x1, lowest_dc_yl + 6, vis->m_pname);
+       M_WriteText(vis->x1, lowest_dc_yl, vis->m_pname);
     }
 // *** PID END ***
 }
