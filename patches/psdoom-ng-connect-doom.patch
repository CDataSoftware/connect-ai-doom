+// connect-doom: walking into a closed door opens it, as the use key would. Booth players on a
+// Mac have no right button, and Doom veterans press Space, which fires here. Only a shut door
+// reacts (one already moving or open is left alone), and quietly: no "oof" off plain walls, and
+// a locked door's message and sound come at most once a second.
+static int bump_last = -1000;
+
+static boolean PTR_BumpTraverse (intercept_t* in)
+{
+    line_t	*li = in->d.line;
+    sector_t	*door = li->backsector;
+
+    if (!li->special)
+    {
+	P_LineOpening (li);
+	return openrange > 0;		// see through openings, stop at walls
+    }
+    if (P_PointOnLineSide (usething->x, usething->y, li) == 1 || door == NULL
+	|| door->specialdata || door->ceilingheight > door->floorheight)
+	return false;
+    switch (li->special)
+    {
+      case 1: case 26: case 27: case 28: case 31: case 32: case 33: case 34: case 117: case 118:
+	bump_last = leveltime;
+	P_UseSpecialLine (usething, li, 0);
+	break;
+    }
+    return false;
+}
+
+void P_BumpDoors (mobj_t* mo)
+{
+    int		angle;
+
+    if (!mo->player || leveltime - bump_last < TICRATE || (!mo->momx && !mo->momy))
+	return;
+    usething = mo;
+    angle = R_PointToAngle2 (0, 0, mo->momx, mo->momy) >> ANGLETOFINESHIFT;
+    P_PathTraverse (mo->x, mo->y, mo->x + (USERANGE>>FRACBITS)*finecosine[angle],
+		    mo->y + (USERANGE>>FRACBITS)*finesine[angle], PT_ADDLINES, PTR_BumpTraverse);
+}
