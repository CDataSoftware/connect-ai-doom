diff --git i/trunk/src/d_main.c w/trunk/src/d_main.c
index 125d27b..f7e7a8d 100644
--- i/trunk/src/d_main.c
+++ w/trunk/src/d_main.c
@@ -1239,6 +1239,10 @@ void D_DoomMain (void)
     p = M_CheckParm ("-nopslev");
     if (p)
     {
+// connect-doom: gamemode isn't identified yet at this point (always
+// indetermined with Freedoom), so -nopslev means "the -file map has the
+// three 1024x1024 spawn arenas" unconditionally.
+		ps_level_loaded = true;
 // Add psdoom1.wad if this is registered (Doom 1) or retail (Ultimite Doom).
 // If we loaded it, set the flag to true so we can place the monsters in the
 // correct positions.
diff --git i/trunk/src/pr_process.c w/trunk/src/pr_process.c
index fa4fe83..db10741 100644
--- i/trunk/src/pr_process.c
+++ w/trunk/src/pr_process.c
@@ -6,6 +6,7 @@
 // Copyright (C) 2000 by David Koppenhofer
 
 #include <stdlib.h>
+#include <string.h>
 #include <math.h>
 #include <unistd.h>
 
@@ -872,7 +873,21 @@ void pr_kill(int pid) {
     cmd = "kill -9";
   }
   sprintf(buf, "%s %d", cmd, pid);
-  system(buf);
+  // connect-doom: the kill command's first line of output becomes the
+  // on-screen message ("CHASED CONTINENTAL OIL & GAS $250,000").
+  {
+    static char message[80];
+    FILE *f = popen(buf, "r");
+    if (f) {
+      if (fgets(message, sizeof(message), f)) {
+        message[strcspn(message, "\n")] = '\0';
+        if (message[0]) {
+          players[consoleplayer].message = message;
+        }
+      }
+      pclose(f);
+    }
+  }
 }
 
