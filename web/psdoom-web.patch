+
+#ifdef __EMSCRIPTEN__
+// The web page's prompts for new players: the keycards the player holds (1 blue, 2 yellow, 4 red).
+int web_keys(void)
+{
+    player_t *p = &players[consoleplayer];
+    return (p->cards[it_bluecard] ? 1 : 0) | (p->cards[it_yellowcard] ? 2 : 0) | (p->cards[it_redcard] ? 4 : 0);
+}
+
+// Where the player stands: x and y in map units, and the angle in degrees (0 east, 90 north).
+void web_player(int *out)
+{
+    mobj_t *mo = players[consoleplayer].mo;
+    out[0] = mo ? mo->x >> FRACBITS : 0;
+    out[1] = mo ? mo->y >> FRACBITS : 0;
+    out[2] = mo ? (int) ((double) mo->angle * 360.0 / 4294967296.0) : 0;
+}
+
+// The page's AI settings changed: the Options menu's Model row lists `models` now (comma-separated,
+// as PSDOOM_AGENT_MODELS), with `pick` chosen.
+void web_set_models(const char *models, const char *pick)
+{
+    setenv("PSDOOM_AGENT_MODELS", models, 1);
+    setenv("PSDOOM_AGENT_MODEL", pick, 1);
+    agent_nmodels = -1;
+    agent_model = 0;
+    agent_read_models();
+}
+#endif
