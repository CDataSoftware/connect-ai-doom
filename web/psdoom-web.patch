diff --git c/trunk/src/i_web.c w/trunk/src/i_web.c
new file mode 100644
index 0000000..a5fb98d
--- /dev/null
+++ w/trunk/src/i_web.c
@@ -0,0 +1,87 @@
+// connect-doom web build: what Emscripten's SDL 1.2 lacks, and the browser's side of the bridge.
+
+#ifdef __EMSCRIPTEN__
+#include <emscripten.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include "SDL.h"
+#include "SDL_mixer.h"
+
+// No text-mode ENDOOM screen in a browser.
+int TXT_Init(void) { return 0; }
+void TXT_Shutdown(void) {}
+unsigned char *TXT_GetScreenData(void) { static unsigned char screen[80 * 25 * 2]; return screen; }
+void TXT_UpdateScreen(void) {}
+int TXT_GetChar(void) { return -1; }
+void TXT_Sleep(int timeout) {}
+
+// The page hides the cursor and locks the pointer itself.
+static int fake_cursor;
+SDL_Cursor *SDL_CreateCursor(const Uint8 *data, const Uint8 *mask, int w, int h, int hot_x, int hot_y) { return (SDL_Cursor *) &fake_cursor; }
+SDL_Cursor *SDL_GetCursor(void) { return (SDL_Cursor *) &fake_cursor; }
+void SDL_SetCursor(SDL_Cursor *cursor) {}
+
+// Mouse movement since the last call, from the browser's movementX/Y (pointer lock).
+EM_JS(int, web_mouse_take, (int *x, int *y), {
+  const m = Module.webMouse || (Module.webMouse = {dx: 0, dy: 0});
+  if (!m.installed) {
+    m.installed = true;
+    document.addEventListener('mousemove', (e) => {
+      if (document.pointerLockElement === Module.canvas) { m.dx += e.movementX; m.dy += e.movementY; }
+    });
+  }
+  if (x) HEAP32[x >> 2] = m.dx;
+  if (y) HEAP32[y >> 2] = m.dy;
+  m.dx = 0; m.dy = 0;
+  return 0;
+});
+Uint8 SDL_GetRelativeMouseState(int *x, int *y) { web_mouse_take(x, y); return 0; }
+
+// Sound: 0 sends i_sdlsound.c to its own resampler; no OPL music hook.
+int SDL_BuildAudioCVT(SDL_AudioCVT *cvt, SDL_AudioFormat sf, Uint8 sc, int sr, SDL_AudioFormat df, Uint8 dc, int dr) { return 0; }
+int SDL_ConvertAudio(SDL_AudioCVT *cvt) { return -1; }
+int Mix_UnregisterAllEffects(int channel) { return 1; }
+void Mix_HookMusic(void (*mix_func)(void *, Uint8 *, int), void *arg) {}
+
+// Doom's 320x200 8-bit frame through its palette (SDL_Color: r, g, b, unused) onto the canvas.
+EM_JS(void, web_present, (unsigned char *frame, unsigned char *palette), {
+  const c = Module.canvas;
+  if (c.width !== 320 || c.height !== 200) { c.width = 320; c.height = 200; Module.webImage = null; }
+  const ctx = Module.webCtx || (Module.webCtx = c.getContext('2d'));
+  const img = Module.webImage || (Module.webImage = ctx.createImageData(320, 200));
+  const px = new Uint32Array(img.data.buffer), pal = new Uint32Array(256);
+  for (let i = 0; i < 256; i++) {
+    const p = palette + i * 4;
+    pal[i] = 0xff000000 | (HEAPU8[p + 2] << 16) | (HEAPU8[p + 1] << 8) | HEAPU8[p];
+  }
+  for (let i = 0; i < 64000; i++) px[i] = pal[HEAPU8[frame + i]];
+  ctx.putImageData(img, 0, 0);
+});
+
+// The bridge: psdoom runs PSDOOMPSCMD / PSDOOMKILLCMD as shell commands. Here the page's
+// Module.bridge(command) answers instead, and its reply is read back like a pipe's output.
+EM_JS(char *, web_bridge_call, (const char *command), {
+  let out = '';
+  try { out = Module.bridge ? String(Module.bridge(UTF8ToString(command)) || '') : ''; }
+  catch (e) { console.error('bridge', e); }
+  return stringToNewUTF8(out);
+});
+
+FILE *web_popen(const char *command, const char *mode)
+{
+    char *out = web_bridge_call(command);
+    FILE *f = fmemopen(NULL, strlen(out) + 1, "w+");
+    if (f) { fputs(out, f); rewind(f); }
+    free(out);
+    return f;
+}
+
+int web_pclose(FILE *f) { return fclose(f); }
+
+int web_system(const char *command)
+{
+    free(web_bridge_call(command));
+    return 0;
+}
+#endif
